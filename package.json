{
  "name": "@jaeungkim/gantt-chart",
  "version": "0.4.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/gantt-chart.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "description": "React Gantt chart with editable bars, dependency arrows, and headless scheduling utilities",
  "keywords": [
    "gantt",
    "gantt-chart",
    "chart",
    "project-management",
    "react",
    "scheduler",
    "scheduling",
    "timeline",
    "critical-path",
    "virtualized"
  ],
  "author": "jaeungkim",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaeungkim/gantt-chart.git"
  },
  "homepage": "https://gantt.jaeungkim.com",
  "bugs": {
    "url": "https://github.com/jaeungkim/gantt-chart/issues"
  },
  "scripts": {
    "dev": "pnpm --filter @gantt-chart/playground dev",
    "build": "vite build && node -e \"require('fs').copyFileSync('dist/index.d.ts','dist/index.d.cts')\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit && tsc --noEmit -p playground",
    "test": "vitest run",
    "docs": "pnpm --filter @gantt-chart/docs dev"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.10",
    "dayjs": "^1.11.23",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^15.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^5.1.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "overrides": {
      "@rushstack/node-core-library>ajv": ">=8.18.0",
      "@microsoft/api-extractor>lodash": ">=4.18.0",
      "@microsoft/api-extractor>minimatch": ">=10.2.3"
    }
  }
}
